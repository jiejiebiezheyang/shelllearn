# ============================================================
#  Shell 脚本从入门到进阶 · 30 讲
#  Git 忽略规则
# ============================================================

# ---------- 操作系统生成的垃圾文件 ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
*~

# ---------- 编辑器 / IDE ----------
.vscode/
.idea/
*.swp
*.swo
.project
.settings/

# ---------- 脚本运行产生的临时产物 ----------
# 第 28 课会生成备份包，第 29 课会生成归档目录；
# 在仓库目录里直接运行脚本时可能留下这些东西
backups/
restore/
*.tar.gz
*.tgz
*.zip
*.log
*.tmp
*.bak
*.orig
*.rej

# ---------- 本地验证 / 调试产物 ----------
.verify/
scratch/
sandbox/
*.out

# ---------- 敏感信息，千万不要提交 ----------
.env
.env.*
*.env
secrets.*
*.pem
*.key
id_rsa*
